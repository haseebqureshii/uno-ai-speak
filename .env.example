# Backend environment (server-side only — never expose keys to the browser)
AUDIO_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Leave TYPESAFE_JEV_API_KEY empty to run System-1 guardrails in local stub mode.
TYPESAFE_JEV_API_KEY=
TYPESAFE_JEV_ENDPOINT=

FRONTEND_ORIGIN=http://localhost:3000

# Frontend environment (must be prefixed with NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_TUTOR_WS_URL=ws://localhost:8000/ws/audio-tutor
